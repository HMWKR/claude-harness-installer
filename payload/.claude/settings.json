{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "KNOT_VAULT": "__HOME__/knot-vault"
  },
  "permissions": {
    "allow": [
      "Bash(claude doctor *)",
      "Bash(claude update *)",
      "Bash(gh repo *)",
      "Bash(git checkout *)",
      "Bash(git show *)",
      "Read(//private/tmp/**)",
      "WebSearch"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.ssh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials.json)",
      "Read(//**/.credentials.json)",
      "mcp__playwright",
      "mcp__claude-in-chrome",
      "mcp__plugin_accesslint_accesslint__audit_live",
      "Bash(npx -y @accesslint/chrome*)",
      "Bash(npx @accesslint/chrome*)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm --recursive*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/adapter-inject.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/uiux-skill-router.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/emulation-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/verify-lock-hook.sh stop",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py stop",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/sanitize-korean.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__codex__codex",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/codex-sandbox-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/codex-sandbox-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py pretooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/design-detect-hook.py",
            "timeout": 15,
            "statusMessage": "Design detect"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/harness-lint-hook.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py posttooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/verify-memory-integrity.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/adapter-inject.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '프로젝트:' $(basename \"$PWD\") && git status --short 2>/dev/null || echo 'Git 저장소 아님'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py sessionstart",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/checkpoint-save.py sessionstart",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/verify-lock-hook.sh taskcompleted",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py precompact",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/checkpoint-save.py precompact",
            "timeout": 5,
            "statusMessage": "체크포인트 저장 중..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/anti-loop-guard.py posttooluse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/checkpoint-save.py sessionend",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "stripe@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "greptile@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "vercel@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "supabase@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "accesslint@accesslint": true,
    "asana@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "laravel-boost@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "watch@claude-video": true,
    "codex@openai-codex": true,
    "understand-anything@understand-anything": true,
    "hookify@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "bkit@bkit-marketplace": true,
    "fablize@fablize": true,
    "superpowers@superpowers-marketplace": true,
    "jusan-harness@claude-templates": true,
    "typescript-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-templates": {
      "source": {
        "source": "github",
        "repo": "HMWKR/CLAUDE-TEMPLATES"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "accesslint": {
      "source": {
        "source": "github",
        "repo": "accesslint/claude-marketplace"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "fablize": {
      "source": {
        "source": "github",
        "repo": "fivetaku/fablize"
      }
    },
    "bkit-marketplace": {
      "source": {
        "source": "github",
        "repo": "popup-studio-ai/bkit-claude-code"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    }
  },
  "ultracode": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
